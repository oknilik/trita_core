{
  "name": "trita",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "check": "pnpm type-check && pnpm lint",
    "test": "pnpm test:unit",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:integration:bootstrap": "node scripts/test-integration-bootstrap.mjs",
    "test:integration:cleanup": "node scripts/test-integration-cleanup.mjs",
    "test:integration:seed": "npx tsx scripts/seed-test-db.ts",
    "test:client": "node scripts/run-tests.mjs client",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:ci": "pnpm test:unit && pnpm test:integration && pnpm test:client && pnpm test:e2e",
    "test:watch": "node scripts/run-tests.mjs unit --watch",
    "test:e2e:ui": "node scripts/run-tests.mjs e2e --ui",
    "test:quality-gate": "node scripts/quality-gate-check.mjs",
    "test:quality-gate:staged": "node scripts/quality-gate-check.mjs --staged",
    "lint:ui:hex:new": "node scripts/check-no-new-ui-hex.mjs",
    "perf:pages": "node scripts/measure-page-queries.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "audit:ui:write": "node scripts/ui-audit.mjs --write",
    "audit:ui:guardrail": "node scripts/ui-audit-guardrail.mjs",
    "test:ui:surface": "node scripts/ui-surface-guardrail.mjs",
    "test:ui:smoke": "node scripts/ui-smoke-check.mjs",
    "test:ui:smoke:list": "node scripts/ui-smoke-check.mjs --list",
    "test:blocks": "node scripts/run-test-blocks.mjs --layers=unit",
    "test:blocks:all": "node scripts/run-test-blocks.mjs --layers=unit,integration,client",
    "test:blocks:full": "node scripts/run-test-blocks.mjs --layers=unit,integration,client,e2e",
    "test:journey": "NODE_OPTIONS='--conditions=react-server' npx tsx --test tests/unit/journey/*.test.ts",
    "test:journey:smoke": "NODE_OPTIONS='--conditions=react-server' npx tsx --test tests/unit/journey/journey-contract.smoke.test.ts",
    "test:acceptance": "NODE_OPTIONS='--conditions=react-server' npx tsx --test tests/integration/acceptance/*.test.ts",
    "postinstall": "prisma generate",
    "seed:assessment": "npx tsx scripts/seed-assessment.ts",
    "seed:personas": "npx tsx scripts/seed-personas.ts",
    "report:personas": "npx tsx scripts/generate-persona-reports.tsx",
    "seed:org-team": "npx tsx scripts/seed-org-team.ts",
    "seed:banan": "npx tsx scripts/seed-banan-demo.ts",
    "seed:psych-safety": "npx tsx scripts/seed-psych-safety.ts",
    "seed:blocks": "npx tsx scripts/seed-recommendation-blocks.ts",
    "pregen:outputs": "npx tsx scripts/pre-generate-outputs.ts",
    "pregen:outputs:haiku3": "npx tsx scripts/pre-generate-outputs.ts --provider anthropic --model claude-3-haiku-20240307 --concurrency 4",
    "pregen:outputs:haiku3:quality": "npx tsx scripts/pre-generate-outputs.ts --provider anthropic --model claude-3-haiku-20240307 --rewrite-model claude-3-haiku-20240307 --rewrite-max-attempts 1 --min-quality-score 80 --concurrency 4",
    "pregen:outputs:fast": "npx tsx scripts/pre-generate-outputs.ts --provider openai --model gpt-4.1-mini --concurrency 8",
    "audit:outputs": "npx tsx scripts/audit-generated-outputs.ts",
    "audit:outputs:hu": "npx tsx scripts/audit-generated-outputs.ts --locale hu --test-type HEXACO --limit 200 --min-score 78"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@clerk/nextjs": "^6.32.0",
    "@prisma/client": "6.6.0",
    "@react-pdf/renderer": "^4.3.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.30.0",
    "gray-matter": "^4.0.3",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reading-time": "^1.5.0",
    "resend": "^6.9.1",
    "server-only": "^0.0.1",
    "svix": "^1.36.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "prisma": "6.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
