generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS - Research Study Types
// ============================================

enum TestType {
  HEXACO
  HEXACO_MODIFIED
  BIG_FIVE
}

enum RelationshipType {
  FRIEND
  COLLEAGUE
  FAMILY
  PARTNER
  OTHER
}

enum InvitationStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELED
}

enum UserRole {
  INDIVIDUAL
  ORG_ADMIN
  ORG_MEMBER
}

enum ScoreRange {
  LOW
  MED
  HIGH
}

enum ObserverType {
  INTERNAL
  EXTERNAL
  ANONYMOUS
}

// ============================================
// MODELS
// ============================================

model UserProfile {
  id        String   @id @default(cuid())
  clerkId   String?  @unique
  email     String?
  username  String?
  activeOrgId String?
  deleted   Boolean  @default(false)
  locale    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Demographic data (onboarding)
  birthYear   Int?
  gender      String?
  country     String?
  avatarUrl   String?
  onboardedAt DateTime?

  // Research study fields
  testType           TestType?
  testTypeAssignedAt DateTime?
  consentedAt           DateTime?
  assessmentSkippedAt   DateTime?

  // Role (default: INDIVIDUAL)
  role      UserRole @default(INDIVIDUAL)

  assessmentResults    AssessmentResult[]
  assessmentDraft      AssessmentDraft?
  sentInvitations      ObserverInvitation[] @relation("InviterInvitations")
  receivedInvitations  ObserverInvitation[] @relation("ObserverInvitations")
  satisfactionFeedback SatisfactionFeedback?
  researchSurvey       ResearchSurvey?
  featureInterests     FeatureInterest[]

  // Team layer (KKV)
  ownedTeams       Team[]       @relation("TeamOwner")
  teamMemberships  TeamMember[]

  // Organization layer (KKV)
  ownedOrgs      Organization[]       @relation("OrgOwner")
  orgMemberships OrganizationMember[]
  activeOrg      Organization?        @relation("ActiveOrgContext", fields: [activeOrgId], references: [id], onDelete: SetNull)

  // Campaign layer (360°)
  createdCampaigns       Campaign[]            @relation("CampaignCreator")
  campaignParticipations CampaignParticipant[]

  // Candidate hiring layer
  managedCandidates CandidateInvite[] @relation("ManagedCandidates")

  // Billing: one-time purchases
  purchases Purchase[]

  // Team role layer
  teamRoleAnswer TeamRoleAnswer?
  teamRoleScore  TeamRoleScore?

  // Notifications
  notifications Notification[]

  @@index([activeOrgId])
}

model AssessmentDraft {
  id            String   @id @default(cuid())
  userProfileId String   @unique
  testType      TestType
  answers       Json     // Record<number, number> — questionId → value
  currentPage   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userProfileId], references: [id])
}

model AssessmentResult {
  id            String   @id @default(cuid())
  userProfileId String?
  scores        Json
  createdAt     DateTime @default(now())

  // Research study fields
  testType         TestType?
  isSelfAssessment Boolean   @default(true)

  // Public share
  shareToken       String?   @unique

  userProfile       UserProfile?        @relation(fields: [userProfileId], references: [id])
  dimensionFeedback DimensionFeedback[]

  @@index([userProfileId])
}

// Observer invitation for peer assessment
model ObserverInvitation {
  id            String           @id @default(cuid())
  token         String           @unique @default(cuid())
  inviterId     String
  observerProfileId String?
  observerEmail String?
  observerName  String?
  testType      TestType
  status        InvitationStatus @default(PENDING)
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  completedAt        DateTime?
  reminderCount      Int              @default(0)
  lastReminderSentAt DateTime?
  observerType       ObserverType     @default(INTERNAL)
  externalContext    String?

  inviter    UserProfile         @relation("InviterInvitations", fields: [inviterId], references: [id])
  observer   UserProfile?        @relation("ObserverInvitations", fields: [observerProfileId], references: [id])
  assessment ObserverAssessment?
  draft      ObserverDraft?

  @@index([inviterId])
  @@index([observerProfileId])
  @@index([token])
}

// Draft state for in-progress observer assessments
model ObserverDraft {
  id               String   @id @default(cuid())
  invitationId     String   @unique
  phase            String   @default("assessment")
  relationshipType String
  knownDuration    String
  answers          Json
  currentPage      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invitation ObserverInvitation @relation(fields: [invitationId], references: [id])
}

// Observer's assessment of the inviter
model ObserverAssessment {
  id               String           @id @default(cuid())
  invitationId     String           @unique
  relationshipType RelationshipType
  knownDuration    String // "LT_1", "1_3", "3_5", "5P"
  scores           Json
  confidence       Int? // 1-5: observer's self-rated certainty (research quality filter)
  createdAt        DateTime         @default(now())

  invitation ObserverInvitation @relation(fields: [invitationId], references: [id])
}

// Merged post-results research survey (replaces SatisfactionFeedback in UI)
model ResearchSurvey {
  id                 String   @id @default(cuid())
  userProfileId      String   @unique
  createdAt          DateTime @default(now())

  selfAccuracy          Int      // 1-5: how well they recognized themselves
  priorTest             String   // "mbti" | "bigfive" | "other" | "none"
  positionLevel         String?  // "junior" | "middle" | "senior" | "independent" — employed only
  studyField            String?  // "business" | "stem" | "humanities" | "health" | "other" — student only
  industry              String?  // sector — employed/student
  motivation            String   // comma-separated: selfknowledge, career, study, recommended, curiosity
  sharingIntent         String   // comma-separated: manager, hr, colleagues, friends, nobody
  feedbackSources       String?  // comma-separated: manager, peers, reports, clients, none — employed only
  has360Process         String?  // "yes" | "no" | "unknown" — employed only
  personalityImportance Int?     // 1-5: how important is personality at work
  observerUsefulness    Int?     // 1-5, only if observer feedback exists

  userProfile UserProfile @relation(fields: [userProfileId], references: [id])
}

// Satisfaction feedback for research comparison
model SatisfactionFeedback {
  id                         String   @id @default(cuid())
  userProfileId              String   @unique
  agreementScore             Int // 1-5 (😕😐🙂😊🤩) - "Mennyire ismertél magadra?"
  observerFeedbackUsefulness Int? // 1-5 (😕😐🙂😊🤩) - Optional: usefulness of observer feedback
  siteUsefulness             Int? // 1-5 (😕😐🙂😊🤩) - Optional: overall site usefulness
  freeformFeedback           String?
  interestedInUpdates        Boolean @default(false)
  createdAt                  DateTime @default(now())

  userProfile UserProfile @relation(fields: [userProfileId], references: [id])
}

// Dimension-level feedback for accuracy assessment
model DimensionFeedback {
  id                String   @id @default(cuid())
  assessmentResultId String
  dimensionCode     String   // "H", "E", "X", "A", "C", "O"
  accuracyRating    Int      // 1-5 (😕😐🙂😊🤩)
  comment           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assessmentResult AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)

  @@unique([assessmentResultId, dimensionCode])
  @@index([assessmentResultId])
}

// Upcoming feature interest — fake door validation
model FeatureInterest {
  id            String   @id @default(cuid())
  userProfileId String
  featureKey    String   // "team" | "comm" | "360"
  createdAt     DateTime @default(now())

  userProfile UserProfile @relation(fields: [userProfileId], references: [id])

  @@unique([userProfileId, featureKey])
  @@index([featureKey])
}

// ============================================
// TEAM LAYER (KKV)
// ============================================

model Team {
  id                   String    @id @default(cuid())
  name                 String
  ownerId              String
  orgId                String?
  createdAt            DateTime  @default(now())
  teamRoleRoundActive    Boolean   @default(false) @map("belbinRoundActive")
  teamRoleRoundStartedAt DateTime? @map("belbinRoundStartedAt")

  owner            UserProfile        @relation("TeamOwner", fields: [ownerId], references: [id])
  org              Organization?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  members          TeamMember[]
  pendingInvites   TeamPendingInvite[]
  candidateInvites CandidateInvite[]

  @@index([ownerId])
  @@index([orgId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member") // "member" | "manager" | "admin"
  joinedAt DateTime @default(now())

  team Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user UserProfile @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// Pending team invites for users who haven't registered yet
model TeamPendingInvite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([email])
}

// ============================================
// CANDIDATE / HIRING LAYER
// ============================================

model CandidateInvite {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  managerId   String
  teamId      String?
  email       String?
  name        String?
  position    String?
  status      String    @default("PENDING")   // PENDING | COMPLETED | EXPIRED
  testType    String    @default("HEXACO")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  completedAt        DateTime?
  draftStartedAt     DateTime?
  draftAnsweredCount Int       @default(0)

  manager UserProfile      @relation("ManagedCandidates", fields: [managerId], references: [id])
  team    Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  result  CandidateResult?

  @@index([managerId])
  @@index([token])
  @@index([teamId])
}

model CandidateResult {
  id        String   @id @default(cuid())
  inviteId  String   @unique
  testType  String
  scores    Json
  createdAt DateTime @default(now())

  invite CandidateInvite @relation(fields: [inviteId], references: [id])
}

// ============================================
// ORGANIZATION LAYER (KKV)
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  status    String   @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "PENDING_SETUP"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            UserProfile                @relation("OrgOwner", fields: [ownerId], references: [id])
  activeUsers      UserProfile[]              @relation("ActiveOrgContext")
  members          OrganizationMember[]
  pendingInvites   OrganizationPendingInvite[]
  teams            Team[]
  campaigns        Campaign[]
  subscription     Subscription?
  candidateCredits CandidateCredit[]

  @@index([ownerId])
}

model CandidateCredit {
  id        String   @id @default(cuid())
  orgId     String
  type      String   // "purchase" | "usage" | "refund"
  amount    Int      // positive: top-up, negative: usage
  balance   Int      // running balance AFTER this transaction
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, createdAt])
}

model Subscription {
  id                     String    @id @default(cuid())
  orgId                  String    @unique
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeLatestInvoiceId  String?
  planType               String?   // "team" | "org" | "scale"
  billingInterval        String?   // "monthly" | "annual"
  status                 String    @default("trialing")
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  candidateCredits       Int       @default(0)
  billingoLastDocumentId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model OrganizationMember {
  id       String   @id @default(cuid())
  orgId    String
  userId   String
  role     String    @default("ORG_MEMBER") // "ORG_ADMIN" | "ORG_MANAGER" | "ORG_MEMBER"
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user UserProfile  @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@index([userId, leftAt])
}

model OrganizationPendingInvite {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  role      String   @default("ORG_MEMBER") // "ORG_ADMIN" | "ORG_MANAGER" | "ORG_MEMBER"
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([email])
}

// ── 360° Campaign layer ────────────────────────────────────────────────────

model Campaign {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  description String?
  status      String    @default("DRAFT") // "DRAFT" | "ACTIVE" | "CLOSED"
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?

  org          Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      UserProfile           @relation("CampaignCreator", fields: [createdBy], references: [id])
  participants CampaignParticipant[]

  @@index([orgId])
  @@index([createdBy])
}

model CampaignParticipant {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  addedAt    DateTime @default(now())

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     UserProfile @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

// ============================================
// PURCHASE LAYER (one-time payments)
// ============================================

model Purchase {
  id                      String   @id @default(cuid())

  userProfileId           String
  userProfile             UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  orgId                   String?
  teamId                  String?

  // "self_plus" | "team_snapshot" | "team_deep_dive"
  tier                    String

  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  amount                  Int      // cent-ben (€49 = 4900)
  currency                String   @default("eur")
  status                  String   @default("completed")
  // "pending" | "completed" | "refunded"

  // Advisory tracking (Team Deep Dive tartalmaz 1 session-t)
  includesAdvisory        Boolean  @default(false)
  advisoryUsed            Boolean  @default(false)

  // Candidate credit (későbbi csomagokhoz)
  includedCredits         Int      @default(0)

  metadata                Json?

  // Billingo invoice tracking
  productType             String?  // "self_plus" | "team_snapshot" | "candidate_pack"
  grossAmount             Int?     // bruttó összeg centben (ÁFA-val)
  billingoDocumentId      String?
  billingoDocumentNumber  String?
  invoiceStatus           String   @default("not_applicable") // "pending" | "issued" | "failed" | "not_applicable"

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userProfileId])
  @@index([orgId])
  @@index([teamId])
  @@index([tier])
  @@index([stripeCheckoutSessionId])
}

// ============================================
// TEAM ROLE LAYER
// ============================================

model TeamRoleAnswer {
  id            String   @id @default(cuid())
  userProfileId String   @unique
  answers       Json     // Record<groupIndex 0-6, Record<statementIndex 0-7, points>>
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProfile UserProfile    @relation(fields: [userProfileId], references: [id])
  score       TeamRoleScore?

  @@map("BelbinAnswer")
}

model TeamRoleScore {
  id               String   @id @default(cuid())
  userProfileId    String   @unique
  scores           Json     // Record<roleCode, totalPoints>
  source           String   // "questionnaire" | "estimate"
  teamRoleAnswerId String?  @unique @map("belbinAnswerId")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userProfile    UserProfile     @relation(fields: [userProfileId], references: [id])
  teamRoleAnswer TeamRoleAnswer? @relation(fields: [teamRoleAnswerId], references: [id])

  @@index([userProfileId])
  @@map("BelbinScore")
}

model AdvisorySession {
  id             String    @id @default(cuid())

  orgId          String?
  teamId         String?
  purchaseId     String?
  subscriptionId String?
  requestedById  String

  type           String    // "guided" | "facilitation" | "workshop"
  status         String    @default("requested")
  // "requested" | "scheduled" | "completed" | "canceled"

  scheduledAt    DateTime?
  completedAt    DateTime?
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId])
  @@index([teamId])
  @@index([purchaseId])
}

// ============================================
// BILLING EVENT TRACKING
// ============================================

model BillingEventLog {
  id           String    @id @default(cuid())
  provider     String    // "stripe" | "billingo"
  eventId      String    @unique // Stripe event.id or internal ID
  eventType    String    // e.g. "checkout.session.completed"
  objectId     String?   // Stripe object ID (session, invoice, subscription)
  status       String    @default("processing") // "processing" | "processed" | "failed" | "skipped"
  processedAt  DateTime?
  errorMessage String?
  retryable    Boolean   @default(false)
  retryCount   Int       @default(0)
  lastRetryAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([eventType])
  @@index([status])
  @@index([objectId])
}

model BillingoPartnerLink {
  id               String  @id @default(cuid())
  userId           String? // UserProfile.id — for self purchases
  organizationId   String? // Organization.id — for org/team purchases
  billingoPartnerId String @unique
  email            String
  countryCode      String  @default("HU")
  taxNumber        String?
  euVatNumber      String?
  currency         String  @default("EUR")
  locale           String  @default("hu")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([email])
}

model BillingDocumentLink {
  id                      String  @id @default(cuid())
  sourceType              String  // "purchase" | "subscription_invoice" | "candidate_addon"
  sourceId                String  // Purchase.id or Subscription.id
  stripeInvoiceId         String?
  stripeCheckoutSessionId String?
  billingoDocumentId      String
  billingoDocumentNumber  String?
  documentType            String  // "invoice" | "correction" | "proforma"
  status                  String  @default("issued") // "issued" | "voided" | "corrected"
  createdAt               DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([billingoDocumentId])
  @@index([stripeInvoiceId])
  @@index([stripeCheckoutSessionId])
}

// ── Notification Hub ────────────────────────────────────────────────────────

enum NotificationType {
  OBSERVER_COMPLETED
  RESULT_READY
  PURCHASE_CONFIRMED
  ORG_INVITE_RECEIVED
  CAMPAIGN_LAUNCHED
  CAMPAIGN_CLOSED
  TEAM_MEMBER_ADDED
  ORG_INVITE_ACCEPTED
  TRIAL_ENDING_SOON
  TRIAL_EXPIRED
  PAYMENT_FAILED
  SUBSCRIPTION_FROZEN
  LOW_CANDIDATE_CREDITS
  MEMBER_COMPLETED_ASSESSMENT
  CAMPAIGN_MILESTONE
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  type          NotificationType
  category      String           @default("system")   // assessment | observer | org | campaign | billing | system
  priority      String           @default("normal")   // low | normal | high
  titleKey      String
  bodyKey       String
  vars          Json?
  link          String?
  sourceType    String?          // e.g. "observer_invitation", "campaign", "stripe_invoice"
  sourceId      String?          // e.g. invitationId, campaignId, stripeInvoiceId
  actorUserId   String?          // who triggered this (e.g. observer, inviter)
  dedupeKey     String?          // for dedup: e.g. "PAYMENT_FAILED:orgId:invoiceId"
  read          Boolean          @default(false)
  readAt        DateTime?
  dismissed     Boolean          @default(false)
  dismissedAt   DateTime?
  createdAt     DateTime         @default(now())

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey, userId])
  @@index([userId, dismissed, createdAt])
  @@index([userId, read])
}
