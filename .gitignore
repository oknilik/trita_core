# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# A két *.example fájl SZÁNDÉKOSAN verziókövetett: ezek a magyarázatos
# env-listák (a CLAUDE.md és a launch-checklist is rájuk hivatkozik).
# Valódi titok EGYIKBE SEM kerülhet — csak placeholder értékek.
.env*
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# Playwright artifacts
/playwright-report/
/test-results/

# Futtatás-kimenetek (regenerálhatók, nem forrás):
#   audit-reports/ — pnpm audit:ui, pnpm audit:outputs
#   artifacts/     — a CI és a helyi teszt-futtatás naplói/riportjai
# Korábban commitolva voltak: egy régi futás pillanatképe így a repóban
# maradt, és úgy nézett ki, mintha a jelenlegi állapotot írná le.
/audit-reports/
/artifacts/

# email előnézet-generátor kimenete (scripts/preview-emails.ts)
.email-previews/

# típus-ábra előnézet-generátor kimenete (scripts/preview-type-glyphs.ts)
.glyph-previews/

# generált persona-riport PDF (regenerálható: pnpm report:personas)
docs/testing/persona-riportok*.pdf

# O*NET nyers adat (97MB, letölthető: scripts/career-catalog/step3_onet.py fejléc)
scripts/onet/

# Szerkesztői ábra-előnézet (scripts/preview-editorial-art.ts)
.art-previews/

# Clerk dev-futás scratch lock (regenerálható, törölhető)
clerk.lock
